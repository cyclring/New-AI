<Window x:Class="WorkControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 어시스턴트" Icon="Assi.ico" Width="1180" Height="800" MinWidth="760" MinHeight="520"
        Background="#F4F2EF" Foreground="#252528" FontFamily="Segoe UI, Malgun Gothic" FontSize="14"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#67676E"/>
        <SolidColorBrush x:Key="Line" Color="#E9E8E6"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#3B3B40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EBEAE9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".72"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A1A1AA"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SendAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#202023"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="17" Background="{TemplateBinding Background}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#4B4B51"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="#777780"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value=".32"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EFEEEC"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E9E7E4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#E7E5E2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalAlignment="Left" Cursor="Hand" Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="7" Padding="8,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Chevron" Width="9" Height="9" Stretch="Uniform" Stroke="#777780"
                                                      StrokeThickness="1.6" Data="M 1,1 L 5,5 L 1,9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 1,1 L 5,5 L 9,1"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#F0EFEE"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#EEEBE9"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" Margin="0,5,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8,3,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#FAF9F7" BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,1"
                CornerRadius="13,0,0,13" Padding="12,15,12,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,15">
                        <Border Background="#232326" Width="28" Height="28" CornerRadius="8">
                            <Path Data="M 7,1 L 8.5,5.5 L 13,7 L 8.5,8.5 L 7,13 L 5.5,8.5 L 1,7 L 5.5,5.5 Z"
                                  Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AI 어시스턴트" FontWeight="SemiBold" FontSize="17" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="NewChat" HorizontalContentAlignment="Left" Click="StartNewChat">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,7 L 1,13 L 12,13 L 12,8 M 5,9 L 7,8 L 13,2 L 11,0 L 5,6 Z"
                                  Stroke="#606069" StrokeThickness="1" Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0"/>
                            <TextBlock Text="새 채팅"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenProject" HorizontalContentAlignment="Left" Click="BrowseFolder">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,3 L 6,3 L 8,5 L 14,5 L 14,13 L 1,13 Z" Stroke="#606069"
                                  StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,9,0"/>
                            <TextBlock Text="폴더 열기"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="채팅" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,24,0,8"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <Expander Header="CLI 설정">
                        <StackPanel Margin="8,0">
                            <TextBlock Text="Claude" Margin="0,5,0,2"/>
                            <TextBox x:Name="ClaudeExe" Padding="5" AutomationProperties.Name="Claude CLI"/>
                            <TextBlock Text="Codex" Margin="0,6,0,2"/>
                            <TextBox x:Name="CodexExe" Padding="5" AutomationProperties.Name="Codex CLI"/>
                        </StackPanel>
                    </Expander>
                </Border>
                <ListBox x:Name="Chats" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ChangeChat">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="0,13,13,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="#F0EFEE" BorderThickness="0,0,0,1" Padding="20,11">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenWork" Style="{StaticResource WorkAction}" Content="작업 폴더" Click="OpenWorkFolder" IsEnabled="False"/>
                            <Button x:Name="SavePatch" Style="{StaticResource WorkAction}" Content="변경분 저장" Click="ExportPatch" IsEnabled="False"/>
                            <Button x:Name="CleanWork" Style="{StaticResource WorkAction}" Content="정리" Click="CleanWorkFolder" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="ChatTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ProjectPath" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="Transcript" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="24,17,24,8">
                        <StackPanel x:Name="Messages" MaxWidth="760"/>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="24,4,24,16">
                    <StackPanel MaxWidth="760">
                        <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="8,0,0,7"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="White" BorderThickness="1" BorderBrush="#E5E4E3" CornerRadius="20" Padding="11,10,11,8">
                            <StackPanel>
                                <Grid>
                                    <TextBox x:Name="Prompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160"
                                             Padding="5,5,5,0" BorderThickness="0" Background="Transparent"
                                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="SubmitWithKeyboard"
                                             AutomationProperties.Name="어시에게 메시지 보내기"/>
                                    <TextBlock Text="어시에게 메시지 보내기" Foreground="#787881" Margin="6,5,0,0"
                                               VerticalAlignment="Top" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=Prompt}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <DockPanel Margin="4,3,1,0" LastChildFill="False">
                                    <Button x:Name="Send" DockPanel.Dock="Right" Style="{StaticResource SendAction}"
                                            Click="SendMessage" ToolTip="보내기 · Enter" AutomationProperties.Name="보내기">
                                        <Path Data="M 2,7 L 8,1 L 14,7 M 8,1 L 8,15" Width="15" Height="16" Stretch="Uniform"
                                              Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Button>
                                    <Button x:Name="Stop" DockPanel.Dock="Right" Style="{StaticResource WorkAction}"
                                            Content="중지" Click="StopMessage" IsEnabled="False" Margin="0,0,7,0"/>
                                    <CheckBox x:Name="EditMode" Content="코드 작업" VerticalAlignment="Center" FontSize="12" Margin="2,0,12,0"
                                              ToolTip="선택한 프로젝트의 별도 작업 폴더에서 수정합니다."/>
                                    <ComboBox x:Name="WriterRole" Margin="0,0,10,0" Width="107" SelectedIndex="0" VerticalAlignment="Center"
                                              FontSize="12" ToolTip="코드 작업의 구현 담당" SelectionChanged="ChangeWriterRole">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=EditMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBoxItem Content="구현 · Claude"/>
                                        <ComboBoxItem Content="구현 · Codex"/>
                                    </ComboBox>
                                    <TextBlock Text="Claude · Codex" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Enter 보내기   ·   Shift+Enter 줄바꿈" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
